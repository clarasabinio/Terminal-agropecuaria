# ==============================================================================
# .gitignore - Terminal Agropecuaria
# Proteccion de credenciales, secretos, entornos virtuales y bases de datos
# ==============================================================================

# Variables de entorno y secretos (NUNCA COMPARTIR NI SUBIR A GITHUB)
.env
.env.*
*.env
.env.local
.env.production
.env.staging

# Claves privadas, certificados y credenciales de API / Servicios
*.pem
*.key
*.crt
*.cert
credentials.json
credentials*.json
client_secret*.json
service_account*.json
token.json
tokens.json
secrets.json
auth.json

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Compilacion y cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Bases de datos locales y volcados
db.sqlite3
*.sqlite3
*.sqlite
*.db
*.sql
*.dump
pgdata/

# Archivos de registro y logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuraciones de editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
